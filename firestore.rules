rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // helpers
    function isSignedIn() { return request.auth != null; }
    function isMaster() { 
      return isSignedIn() && (
        request.auth.token.email == 'esdrasgomes547@gmail.com' ||
        exists(/databases/$(database)/documents/masters/$(request.auth.token.email))
      );
    }
    
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    
    function isOrgMember(orgId) {
      return isSignedIn() && getUserData().orgId == orgId;
    }

    function isPremium() {
      return isSignedIn() && getUserData().role == 'premium_max';
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    match /users/{uid} {
      allow read, write: if isMaster() || (isSignedIn() && request.auth.uid == uid);
    }

    match /masters/{email} {
      allow read: if isMaster();
    }

    match /organizations/{orgId} {
      allow read: if isMaster() || isOrgMember(orgId);
      allow write: if isMaster() || (isOrgMember(orgId) && isPremium());
    }

    match /organizations/{orgId}/{collection}/{docId} {
      allow read: if isMaster() || isOrgMember(orgId) || orgId == 'demo-org';
      allow write: if isMaster() || (isOrgMember(orgId) && isPremium()) || orgId == 'demo-org';
    }

    match /organizations/{orgId}/{collection}/{docId}/{subCol}/{subDocId} {
      allow read: if isMaster() || isOrgMember(orgId) || orgId == 'demo-org';
      allow write: if isMaster() || (isOrgMember(orgId) && isPremium()) || orgId == 'demo-org';
    }
  }
}

